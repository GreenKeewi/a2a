DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres
BETTER_AUTH_URL=http://127.0.0.1:4300
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Optional smart suggestions. Leave A2A_TRIAGE_MODEL unset to disable all model calls.
# Use an AI Gateway model id and configure the server-side Gateway key if needed.
# A2A_TRIAGE_MODEL=provider/model-name
# AI_GATEWAY_API_KEY=replace-with-server-side-gateway-key
# Protects the internal smart-job recovery endpoint when a scheduler is configured.
# CRON_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Import an ES256 private JWK as a Supabase JWT signing key. Keep the matching
# private JWK in the server environment only; it must include the key's kid.
SUPABASE_JWT_PRIVATE_JWK={"kty":"EC","crv":"P-256","kid":"REPLACE_ME","x":"REPLACE_ME","y":"REPLACE_ME","d":"REPLACE_ME"}
